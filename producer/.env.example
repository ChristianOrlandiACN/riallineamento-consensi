# Copiare in .env e NON committare mai .env
AWS_REGION=eu-west-1

# Nome del secret su Secrets Manager (formato JSON: host, port, username, password)
DB_SECRET_NAME=riallineamento-consensi/db-credentials

# Database e tabella sorgente (aggiornare quando Antonio Croce fornirà i dettagli)
DB_NAME=nome_database
DB_TABLE=consensi

# URL della coda SQS principale
SQS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/<account-id>/riallineamento-consensi-queue

# Numero di record letti dal DB per ogni pagina (default 500)
# Aumentare se il Lambda finisce il tempo prima di completare il dataset
PAGE_SIZE=500
