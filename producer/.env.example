# Copiare in .env — NON committare mai .env
AWS_REGION=eu-west-1
DB_SECRET_NAME=prod/dmf/db/hot
DB_HOST=sky-dmf-prod-hot-db.cvmeoqosyucw.eu-west-1.rds.amazonaws.com
DB_PORT=6543
DB_NAME=sky-dmf-prod-hot-db
DB_SCHEMA=audit
DB_TABLE=audit_sky_recs_recommendation
SQS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/654654357496/crm-dmf-consent-queue
PAGE_SIZE=500
AUDIT_BUCKET=crm-dmf-consent-audit

# Identificativo campagna: chiave su audit.consent_realign_state e cartella audit S3
RUN_ID=riallineamento-2026-09

# Durata del lock sul segnaposto, deve superare il timeout Lambda (300s)
LEASE_SECONDS=360

# Tetto di record per invocazione, 0 = nessun limite.
# 25 per il collaudo, poi 0 per lasciar correre la campagna.
MAX_RECORDS=25
