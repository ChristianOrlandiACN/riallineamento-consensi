# Copiare in .env — NON committare mai .env
AWS_REGION=eu-west-1

# Base URL API Hermes
# Produzione: https://servizi.sky.it/hermes/v0
# Collaudo:   https://servizicollaudo.sky.it/hermes-st/v0
HERMES_BASE_URL=https://servizicollaudo.sky.it/hermes-st/v0

# Timeout chiamata Hermes in ms (default 10000)
HERMES_TIMEOUT_MS=10000

