# Copiare in .env e NON committare mai .env
AWS_REGION=eu-west-1

# Base URL API Hermes
# Produzione:  https://servizi.sky.it/hermes/v0
# Collaudo:    https://servizicollaudo.sky.it/hermes-st/v0
REX_BASE_URL=https://servizicollaudo.sky.it/hermes-st/v0

# Timeout chiamata Hermes in ms (default 10000)
REX_TIMEOUT_MS=10000

# TODO: credenziali MDW e certificato TLS – da ricevere lato ACN
# REX_SECRET_NAME=riallineamento-consensi/hermes-credentials
